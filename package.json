{
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:ui:local": "cross-env ENV=local npx playwright test --ui",
    "test:ui:prod": "cross-env ENV=prod npx playwright test --ui",
    "test:prod:targeted": "cross-env ENV=prod npx playwright test --grep @targeted",
    "test:ui:local:smoke": "cross-env ENV=local npx playwright test --ui --grep @smoke",
    "test:local:smoke": "cross-env ENV=local npx playwright test --grep @smoke",

    "test:ci": "cross-env ENV=prod npx playwright test",
    "test:chrm:ci": "cross-env ENV=prod npx playwright test --project=chromium"
  }
}
